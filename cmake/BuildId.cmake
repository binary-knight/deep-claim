# Writes a header defining DC_BUILD_ID as the short git revision of the
# source tree, or "unknown" when that cannot be read. Run in script mode, at
# build time, by the dc_build_id target (see the root CMakeLists.txt):
#
#   cmake -DDC_SOURCE_DIR=<repo> -DDC_BUILD_ID_HEADER=<out.h>
#         [-DGIT_EXECUTABLE=<git>] -P cmake/BuildId.cmake
#
# The header is rewritten only when its content changes, so a build with no
# new commit leaves its timestamp alone and nothing recompiles or relinks.
if(NOT DEFINED DC_SOURCE_DIR OR NOT DEFINED DC_BUILD_ID_HEADER)
    message(FATAL_ERROR "BuildId.cmake needs -DDC_SOURCE_DIR and -DDC_BUILD_ID_HEADER")
endif()

set(DC_BUILD_ID "unknown")

# Only a checkout rooted at the source directory counts (.git is a directory
# in a clone and a file in a worktree or submodule). Without this test a
# source archive unpacked inside some other repository would be labelled
# with that repository's revision.
if(EXISTS "${DC_SOURCE_DIR}/.git")
    if(NOT GIT_EXECUTABLE)
        find_program(GIT_EXECUTABLE NAMES git)
    endif()
    if(GIT_EXECUTABLE)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" rev-parse --short HEAD
            WORKING_DIRECTORY "${DC_SOURCE_DIR}"
            OUTPUT_VARIABLE DC_GIT_REV
            OUTPUT_STRIP_TRAILING_WHITESPACE
            RESULT_VARIABLE DC_GIT_RESULT
            ERROR_QUIET)
        # The revision ends up inside a C string literal; accept only what a
        # short hash can be, so nothing unexpected is ever written there.
        if(DC_GIT_RESULT EQUAL 0 AND DC_GIT_REV MATCHES "^[0-9a-f]+$")
            set(DC_BUILD_ID "${DC_GIT_REV}")
        endif()
    endif()
endif()

set(DC_BUILD_ID_CONTENT "// Generated by cmake/BuildId.cmake on every build. Do not edit.
#pragma once
#define DC_BUILD_ID \"${DC_BUILD_ID}\"
")

set(DC_BUILD_ID_PREVIOUS "")
if(EXISTS "${DC_BUILD_ID_HEADER}")
    file(READ "${DC_BUILD_ID_HEADER}" DC_BUILD_ID_PREVIOUS)
endif()
if(NOT DC_BUILD_ID_PREVIOUS STREQUAL DC_BUILD_ID_CONTENT)
    file(WRITE "${DC_BUILD_ID_HEADER}" "${DC_BUILD_ID_CONTENT}")
    message(STATUS "Build id: ${DC_BUILD_ID}")
endif()
