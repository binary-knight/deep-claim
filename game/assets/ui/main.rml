<rml>
<head>
    <title>Deep Claim</title>
    <link type="text/rcss" href="main.rcss"/>
</head>
<!-- Plate C "Control Room", dashboard H4 (docs/design/handoff.md). Every
     sentence here is bound from the prose catalogue (data/strings.json, spec
     002); only one- or two-word labels on buttons, columns and chips are
     literal. Section indices restart at 01 on each screen. -->
<body data-model="game">
    <div id="header">
        <div class="stat company"><span class="label">Company</span><span class="value">{{company}}</span></div>
        <div class="stat"><span class="label">Date</span><span class="value">{{day}}</span></div>
        <div class="stat"><span class="label">Cash</span><span class="value">{{cash}}</span></div>
        <div class="stat"><span class="label">Available</span><span class="value">{{available}}</span></div>
        <div class="stat"><span class="label">Debt</span><span class="value">{{debt}}</span></div>
        <div class="stat"><span class="label">Cash, 90 days</span><price-chart class="spark" series="cash" days="90" mode="line"/></div>
        <div class="grow"></div>
        <div class="speed">
            <!-- Off once the game is over (spec 010): the clock cannot be restarted. -->
            <button data-class-active="speed == 0" data-class-disabled="game_over" data-event-click="set_speed(0)">Pause</button>
            <button data-class-active="speed == 1" data-class-disabled="game_over" data-event-click="set_speed(1)">1x</button>
            <button data-class-active="speed == 2" data-class-disabled="game_over" data-event-click="set_speed(2)">5x</button>
            <button data-class-active="speed == 3" data-class-disabled="game_over" data-event-click="set_speed(3)">20x</button>
            <button data-class-disabled="game_over" data-event-click="step"><span class="long">Step day</span><span class="short">Step</span></button>
            <!-- Orders wait for the clock (spec 007): the count opens the list.
                 It hangs under the buttons, out of the row, because the header
                 has no width to spare once the company name is a long one. -->
            <div class="waiting" data-if="has_pending" data-class-active="show_pending_list" data-event-click="toggle_pending_list">{{pending_line}}</div>
        </div>
        <div class="sys">
            <button data-class-active="show_pause_menu" data-event-click="toggle_pause_menu"><span class="long">Stops</span><span class="short">Stops</span></button>
            <button data-event-click="save">Save</button>
            <button data-event-click="load">Load</button>
            <button data-event-click="new_game"><span class="long">New game</span><span class="short">New</span></button>
        </div>
        <div id="pendinglist" data-if="show_pending_list && has_pending">
            <span class="title">{{pending_line}}</span>
            <div class="needs">
                <div data-for="o : pending_orders" class="nrow">
                    <span class="t"><span class="title">{{o.text}}</span></span>
                    <span class="act"><span class="chip warn" data-if="o.not_covered">{{ui_not_covered}}</span><button class="sm" data-event-click="cancel(o.id)">{{ui_cancel}}</button></span>
                </div>
            </div>
            <div class="foot"><button class="sm" data-event-click="cancel_all">{{ui_cancel_all}}</button></div>
        </div>
        <div id="pausemenu" data-if="show_pause_menu">
            <span class="title">{{ui_pause_menu_title}}</span>
            <div data-for="p : pause_rows" class="check" data-class-on="p.on" data-event-click="toggle_pause(p.index)"><span class="box"></span>{{p.label}}</div>
        </div>
    </div>

    <div id="strip">
        <span class="item"><span class="k">Month</span><span class="num" data-class-good="month_good" data-class-danger="!month_good">{{month_net}}</span></span>
        <span class="item"><span class="k">Storage</span><span class="num">{{storage_month}}</span></span>
        <span class="item"><span class="k">Solvency</span><span class="chip" data-class-good="solvent" data-class-danger="!solvent">{{solvency}}</span> <span class="muted">{{solvency_sub}}</span></span>
        <span class="item"><span class="k">Next auction</span><span class="num">{{next_auction}}</span></span>
        <span class="item"><span class="k">Mines</span><span class="chip good" data-if="mines_operating != ''">{{mines_operating}}</span><span class="chip warn" data-if="mines_building != ''">{{mines_building}}</span><span class="chip muted" data-if="mines_mothballed != ''">{{mines_mothballed}}</span><span class="chip muted" data-if="mines_depleted != ''">{{mines_depleted}}</span><span class="muted" data-if="mines_operating == '' && mines_building == '' && mines_mothballed == '' && mines_depleted == ''">none</span></span>
        <span class="item" data-if="has_committed"><span class="num">{{committed}}</span><span class="chip warn" data-if="pending_shortfall">{{ui_not_covered}}</span></span>
        <span class="brk"></span>
        <!-- The race (spec 010), on every tab: the time left and whether the
             player leads, in words. The header has no width for it once the
             company name and the figures are long ones. Ahead of it, an item
             of its own so it wraps on its own (spec 011): when the leading
             rival could found the program before the deadline, how soon. -->
        <span class="item race" data-if="race_rival != ''"><span class="couldfound">{{race_rival}}</span></span>
        <span class="item race" data-if="has_race"><span class="num deadline" data-if="race_deadline != ''">{{race_deadline}}</span><span class="founded" data-if="race_founded != ''">{{race_founded}}</span><span class="chip verdict" data-if="race_verdict != ''" data-class-good="race_verdict_class == 'good'" data-class-warn="race_verdict_class == 'warn'">{{race_verdict}}</span></span>
        <span class="item"><span class="k">Research</span><span class="num">{{research_strip}}</span></span>
        <span class="item" data-if="has_world"><span class="k">World</span><span class="chip warn">{{world_event}}</span> <span class="num">{{world_sub}}</span></span>
    </div>

    <div id="body">
        <div id="rail">
            <div class="tab" data-class-active="tab == 0" data-event-click="set_tab(0)"><span class="ic dashboard"></span><span class="tl">Dashboard</span></div>
            <!-- Program (spec 010) is tab 6 by number and second on the rail. -->
            <div class="tab" data-class-active="tab == 6" data-event-click="set_tab(6)"><span class="ic program"></span><span class="tl">Program</span></div>
            <div class="tab" data-class-active="tab == 1" data-event-click="set_tab(1)"><span class="ic plots"></span><span class="tl">Plots</span></div>
            <div class="tab" data-class-active="tab == 2" data-event-click="set_tab(2)"><span class="ic market"></span><span class="tl">Market</span></div>
            <div class="tab" data-class-active="tab == 3" data-event-click="set_tab(3)"><span class="ic research"></span><span class="tl">Research</span></div>
            <div class="tab" data-class-active="tab == 4" data-event-click="set_tab(4)"><span class="ic finance"></span><span class="tl">Finance</span></div>
            <div class="tab" data-class-active="tab == 5" data-event-click="set_tab(5)"><span class="ic log"></span><span class="tl">Log</span></div>
        </div>

        <div id="content">
            <!-- Dashboard (H4): what needs you, then what you own, then the money -->
            <div data-if="tab == 0">
                <h1>Dashboard</h1>
                <!-- The race for the program (spec 010): the deadline, then a
                     line a company. Progress is a bar with its figure beside
                     it, and who leads is a word, so neither rests on colour.
                     Each company's earliest founding day sits under its name
                     (spec 011), and research under way gives its due day. -->
                <div id="race" data-if="has_race">
                    <div class="when">
                        <span class="deadline" data-if="race_deadline != ''">{{race_deadline}}</span>
                        <span class="founded" data-if="race_founded != ''">{{race_founded}}</span>
                        <span class="verdictline" data-if="race_verdict != ''"><span class="chip verdict" data-class-good="race_verdict_class == 'good'" data-class-warn="race_verdict_class == 'warn'">{{race_verdict}}</span></span>
                    </div>
                    <div class="rows">
                        <div data-for="r : race_rows" class="rrow">
                            <span class="who"><span class="nm">{{r.name}}</span><span class="founding" data-if="r.founding != ''">{{r.founding}}</span></span>
                            <span class="stage num">{{r.stage}}</span>
                            <div class="bar"><div class="fill" data-style-width="r.bar_width"></div></div>
                            <span class="pct num">{{r.progress}}</span>
                            <span class="research">{{r.research}}</span>
                        </div>
                    </div>
                </div>
                <div class="sheet">
                    <h2><span class="idx">01</span>Needs you</h2>
                    <div class="needs">
                        <div data-for="n : needs" class="nrow">
                            <span class="n">{{n.number}}</span>
                            <span class="t"><span class="title">{{n.title}}</span><span class="sub">{{n.sub}}</span></span>
                            <span class="days">{{n.days}}</span>
                            <span class="act"><button class="sm" data-if="n.action > 0 && !n.order.pending" data-class-primary="n.action == 1" data-event-click="need_action(n.action, n.target)">{{n.act_label}}</button><span class="chip accent" data-if="n.order.pending">{{n.order.text}}</span><button class="sm" data-if="n.order.pending" data-event-click="cancel(n.order.id)">{{ui_cancel}}</button></span>
                        </div>
                        <div class="none" data-if="needs_none != ''">{{needs_none}}</div>
                    </div>
                </div>
                <div class="split">
                    <div class="main">
                        <div class="sheet">
                            <h2><span class="idx">02</span>Plots and mines</h2>
                            <table>
                                <tr><th class="w-plot">Plot</th><th class="w-region2">Region</th><th class="w-mine">Mine</th><th>Output</th><th>Remaining</th><th class="act w-act" data-class-wide="owned_orders"></th></tr>
                                <tr data-for="o : owned" class="row" data-event-click="select_plot(o.index)">
                                    <td class="name num">{{o.name}}</td>
                                    <td class="nw">{{o.region}} <span class="muted num area">{{o.area}}</span></td>
                                    <td class="nw"><span class="chip" data-class-good="o.mine_class == 'good'" data-class-warn="o.mine_class == 'warn'" data-class-muted="o.mine_class == 'muted'" data-class-danger="o.mine_class == 'danger'">{{o.mine}}</span></td>
                                    <td class="figure wrap">{{o.output}}<span class="sub" data-if="o.figures.shown" data-class-warn="o.figures.loss">{{o.figures.earns}} <span data-if="o.figures.loss">{{ui_mine_loss}}</span></span><span class="sub" data-if="o.figures.reopen != ''" data-class-warn="o.figures.reopen_loss">{{ui_mine_if_reopened}} {{o.figures.reopen}}</span><span class="sub" data-if="o.figures.break_even != ''">{{o.figures.break_even}}</span></td>
                                    <td class="figure wrap">{{o.remaining}}</td>
                                    <td class="act"><button class="sm" data-if="!o.mine_order.pending && o.can_toggle && o.mine_operating" data-event-click="toggle_mine(o.mine_index)">Mothball</button><button class="sm" data-if="!o.mine_order.pending && o.can_toggle && !o.mine_operating" data-event-click="toggle_mine(o.mine_index)">Reopen</button><span class="chip accent" data-if="o.mine_order.pending">{{o.mine_order.text}}</span><button class="sm" data-if="o.mine_order.pending" data-event-click="cancel(o.mine_order.id)">{{ui_cancel}}</button><span class="chip accent" data-if="o.build_order.pending">{{o.build_order.text}}</span><button class="sm" data-if="o.build_order.pending" data-event-click="cancel(o.build_order.id)">{{ui_cancel}}</button></td>
                                </tr>
                            </table>
                            <div class="rivalline">{{rival_line}}</div>
                        </div>
                    </div>
                    <div class="side narrow">
                        <div class="sheet">
                            <h2><span class="idx">03</span>Prices</h2>
                            <div class="prices">
                                <div data-for="r : resources" class="pr">
                                    <span class="nm" data-class-muted="r.locked">{{r.name}}<span class="sub"><span class="warn" data-if="r.locked">locked · </span>{{r.stock_sub}}</span></span>
                                    <price-chart data-attr-resource="r.index" days="90" mode="line"/>
                                    <span class="num">{{r.price}}<span class="sub" data-class-warn="r.ratio_warn">{{r.ratio}}</span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="sheet">
                    <h2><span class="idx">04</span>Finance</h2>
                    <div class="finrow">
                        <div class="stat"><span class="label">Cash</span><span class="value">{{cash}}</span></div>
                        <div class="stat"><span class="label">Available</span><span class="value">{{available}}</span></div>
                        <div class="stat"><span class="label">Debt</span><span class="value">{{debt}}</span><span class="sub">{{capacity_sub}}</span></div>
                        <div class="stat"><span class="label">Warehouse</span><span class="value">{{warehouse_value}}</span><span class="sub wrapok">{{storage_sub}}</span></div>
                        <div class="stat"><span class="label">This month</span><span class="value" data-class-good="month_good" data-class-danger="!month_good">{{month_net}}</span><span class="sub">{{instalment_sub}}</span></div>
                        <div class="stat"><span class="label">Solvency</span><span class="chipline"><span class="chip" data-class-good="solvent" data-class-danger="!solvent">{{solvency}}</span></span><span class="sub wrapok">{{solvency_sub}}</span></div>
                    </div>
                </div>
                <div class="sheet">
                    <h2><span class="idx">05</span>Recent</h2>
                    <div class="log">
                        <div data-for="e : recent" class="line" data-class-warn="e.warning"><span class="d">{{e.day}}</span><span class="t">{{e.text}}</span></div>
                    </div>
                </div>
            </div>

            <!-- Program (spec 010): the three stages, then the one being worked
                 on: what it needs of each good, its cost, its research, and
                 the three orders. A control is live when the sim would take
                 its order; an order waiting for the clock stands in for its
                 control as a chip with Cancel (spec 007). Every state is said
                 in words; colour only repeats it. -->
            <div id="program" data-if="tab == 6">
                <h1>{{program.title}}</h1>
                <p class="intro text2">{{program.intro}}</p>
                <div class="notice" data-if="program.cover_warning != ''"><span class="ic">!</span><span class="msg cover">{{program.cover_warning}}</span></div>
                <div class="sheet">
                    <h2><span class="idx">01</span>Stages</h2>
                    <div class="pstages">
                        <div data-for="s : program_stages" class="pstage">
                            <span class="title" data-class-now="s.current">{{s.heading}}</span>
                            <span class="state"><span class="chip" data-class-good="s.state_class == 'good'" data-class-accent="s.state_class == 'accent'" data-class-muted="s.state_class == 'muted'">{{s.state}}</span></span>
                        </div>
                    </div>
                </div>
                <div class="sheet" data-if="program.complete">
                    <p class="done">{{program.done_line}}</p>
                </div>
                <div class="sheet" data-if="program.has_stage">
                    <h2><span class="idx">02</span><span class="heading">{{program.heading}}</span></h2>
                    <table>
                        <tr><th>{{program.col_good}}</th><th class="n w-tonnes">{{program.col_needs}}</th><th class="n w-tonnes">{{program.col_delivered}}</th><th class="n w-tonnes">{{program.col_stock}}</th><th class="n w-tonnes">{{program.col_still}}</th><th class="act w-deliver"></th></tr>
                        <tr data-for="n : program.needs" class="need">
                            <td class="name wrap"><span class="gname">{{n.good}}</span><span class="sub warn locked" data-if="n.locked_note != ''">{{n.locked_note}}</span></td>
                            <td class="n">{{n.needs}}</td>
                            <td class="n">{{n.delivered}}</td>
                            <td class="n">{{n.stock}}</td>
                            <td class="n">{{n.still}}</td>
                            <td class="act"><button class="sm primary" data-if="n.can_deliver && !n.order.pending" data-event-click="deliver(n.index)">{{n.deliver_label}}</button><button class="sm disabled" data-if="!n.can_deliver && !n.order.pending">{{n.deliver_label}}</button><span class="chip accent" data-if="n.order.pending">{{n.order.text}}</span><button class="sm" data-if="n.order.pending" data-event-click="cancel(n.order.id)">{{ui_cancel}}</button><span class="sub note" data-if="n.note != '' && !n.order.pending">{{n.note}}</span></td>
                        </tr>
                    </table>
                    <div class="pfacts"><span class="cost num">{{program.cost}}</span><span class="rname">{{program.research_name}}</span><span class="rstate">{{program.research}}</span></div>
                    <div class="actions pactions">
                        <button data-if="program.research_open && program.can_research && !program.research_order.pending" data-event-click="program_research">{{program.research_label}}</button>
                        <button class="disabled" data-if="program.research_open && !program.can_research && !program.research_order.pending">{{program.research_label}}</button>
                        <span class="hrow" data-if="program.research_order.pending"><span class="chip accent">{{program.research_order.text}}</span><span class="chip warn" data-if="program.research_order.not_covered">{{ui_not_covered}}</span><button data-event-click="cancel(program.research_order.id)">{{ui_cancel}}</button></span>
                        <button class="primary" data-if="program.ready && !program.complete_order.pending" data-event-click="complete_stage">{{program.complete_label}}</button>
                        <button class="disabled" data-if="!program.ready && !program.complete_order.pending">{{program.complete_label}}</button>
                        <span class="hrow" data-if="program.complete_order.pending"><span class="chip accent">{{program.complete_order.text}}</span><span class="chip warn" data-if="program.complete_order.not_covered">{{ui_not_covered}}</span><button data-event-click="cancel(program.complete_order.id)">{{ui_cancel}}</button></span>
                    </div>
                    <!-- Why Start research is off, as the Research tab says it;
                         then what the stage still lacks, or that it lacks nothing. -->
                    <span class="sub warn rblocked" data-if="program.research_blocked != ''">{{program.research_blocked}}</span>
                    <span class="sub warn blocked" data-if="program.blocked_research != ''">{{program.blocked_research}}</span>
                    <span class="sub warn blocked" data-if="program.blocked_deliveries != ''">{{program.blocked_deliveries}}</span>
                    <span class="sub warn blocked" data-if="program.blocked_cash != ''">{{program.blocked_cash}}</span>
                    <span class="sub good ready" data-if="program.ready_line != ''">{{program.ready_line}}</span>
                </div>
            </div>

            <!-- Plots -->
            <div data-if="tab == 1">
                <h1>Plots</h1>
                <div class="split">
                    <div class="main">
                        <div class="sheet">
                            <h2><span class="idx">01</span>For sale</h2>
                            <table>
                                <tr><th class="w-plot">Plot</th><th class="w-region">Region</th><th class="n w-area">Area</th><th class="n w-money">Ask</th><th class="n w-bids">Bids</th><th class="n w-day">Closes</th><th>Survey</th></tr>
                                <!-- The selection class sits on the cells, not the row: this list
                                     shrinks as plots sell, and RmlUi reads a class binding on the
                                     repeated element itself once more after its entry is gone. -->
                                <tr data-for="s : for_sale" class="row" data-event-click="select_plot(s.index)">
                                    <td class="name num" data-class-sel="s.index == selected_plot">{{s.name}}</td>
                                    <td class="nw" data-class-sel="s.index == selected_plot">{{s.region}}</td>
                                    <td class="n" data-class-sel="s.index == selected_plot">{{s.area}}</td>
                                    <td class="n" data-class-sel="s.index == selected_plot">{{s.ask}}</td>
                                    <td class="n" data-class-sel="s.index == selected_plot">{{s.bids}}</td>
                                    <td class="n" data-class-sel="s.index == selected_plot">{{s.closes}}</td>
                                    <td data-class-sel="s.index == selected_plot">{{s.survey}} <span class="muted num" data-if="s.error != ''">{{s.error}}</span> <span class="pill" data-if="s.has_flag" data-class-warn="s.flag_class == 'warn'" data-class-danger="s.flag_class == 'danger'" data-class-good="s.flag_class == 'good'">{{s.flag}}</span> <span class="pill accent" data-if="s.major">major deposit</span></td>
                                </tr>
                            </table>
                            <span class="sub" data-if="no_unlisted != ''">{{no_unlisted}}</span>
                            <!-- What land has sold for (spec 006): the rival's habit of
                                 paying over the ask, readable before the player loses to it. -->
                            <span class="sub cap">Recent sales</span>
                            <table>
                                <tr><th class="w-plot">Plot</th><th>Sold to</th><th class="n w-money">Paid</th><th class="n w-over">Against the ask</th><th class="n w-day">Closed</th></tr>
                                <tr data-for="r : recent_sales" class="row" data-event-click="select_plot(r.index)">
                                    <td class="name num">{{r.name}}</td>
                                    <td class="nw">{{r.buyer}}</td>
                                    <td class="n">{{r.paid}}</td>
                                    <td class="n">{{r.over}}</td>
                                    <td class="n">{{r.day}}</td>
                                </tr>
                            </table>
                            <span class="sub" data-if="no_sales != ''">{{no_sales}}</span>
                        </div>
                        <div class="sheet">
                            <h2><span class="idx">02</span>Owned</h2>
                            <table>
                                <tr><th class="w-plot">Plot</th><th class="w-region">Region</th><th class="w-mine">Mine</th><th>Output</th><th>Remaining</th><th class="act w-act" data-class-wide="owned_orders"></th></tr>
                                <!-- The selection class is bound on the cells, not on the repeated row:
                                     a binding on the repeated element is evaluated once more after the
                                     row is removed, and RmlUi logs an out-of-bounds index when a new
                                     game empties this list (the end screen's New game, spec 010). -->
                                <tr data-for="o : owned" class="row" data-event-click="select_plot(o.index)">
                                    <td class="name num" data-class-sel="o.index == selected_plot">{{o.name}}</td>
                                    <td class="nw" data-class-sel="o.index == selected_plot">{{o.region}}<span class="sub num">{{o.area}}</span></td>
                                    <td class="nw" data-class-sel="o.index == selected_plot"><span class="chip" data-class-good="o.mine_class == 'good'" data-class-warn="o.mine_class == 'warn'" data-class-muted="o.mine_class == 'muted'" data-class-danger="o.mine_class == 'danger'">{{o.mine}}</span></td>
                                    <td class="figure wrap" data-class-sel="o.index == selected_plot">{{o.output}}<span class="sub" data-if="o.figures.shown" data-class-warn="o.figures.loss">{{o.figures.earns}} <span data-if="o.figures.loss">{{ui_mine_loss}}</span></span><span class="sub" data-if="o.figures.reopen != ''" data-class-warn="o.figures.reopen_loss">{{ui_mine_if_reopened}} {{o.figures.reopen}}</span><span class="sub" data-if="o.figures.break_even != ''">{{o.figures.break_even}}</span></td>
                                    <td class="figure wrap" data-class-sel="o.index == selected_plot">{{o.remaining}}</td>
                                    <td class="act" data-class-sel="o.index == selected_plot"><button class="sm" data-if="!o.mine_order.pending && o.can_toggle && o.mine_operating" data-event-click="toggle_mine(o.mine_index)">Mothball</button><button class="sm" data-if="!o.mine_order.pending && o.can_toggle && !o.mine_operating" data-event-click="toggle_mine(o.mine_index)">Reopen</button><span class="chip accent" data-if="o.mine_order.pending">{{o.mine_order.text}}</span><button class="sm" data-if="o.mine_order.pending" data-event-click="cancel(o.mine_order.id)">{{ui_cancel}}</button><span class="chip accent" data-if="o.build_order.pending">{{o.build_order.text}}</span><button class="sm" data-if="o.build_order.pending" data-event-click="cancel(o.build_order.id)">{{ui_cancel}}</button></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="side">
                        <div class="sheet">
                            <h2><span class="idx">03</span>{{panel.title}}</h2>
                            <div data-if="panel.any">
                                <div class="kv"><span class="k">Area</span><span class="v num">{{panel.area}}</span></div>
                                <div class="kv" data-if="panel.listed"><span class="k">Ask</span><span class="v num">{{panel.ask}}</span></div>
                                <div class="kv" data-if="panel.auction != ''"><span class="k">Auction</span><span class="v num">{{panel.auction}}</span></div>
                                <div class="kv" data-if="panel.owner != ''"><span class="k">Owner</span><span class="v">{{panel.owner}}</span></div>
                                <div class="kv" data-if="panel.sale != ''"><span class="k">Sold</span><span class="v num"><span class="line wrapok">{{panel.sale}}</span></span></div>
                                <div class="kv"><span class="k">Mine capex</span><span class="v num">{{panel.capex}}</span></div>
                                <!-- What the player's mine here earns a day at today's price,
                                     and the price at which that is nothing (spec 008). The sim
                                     works both out. A loss carries its minus sign and its own
                                     key as well as the warning colour; a mothballed mine shows
                                     what it costs to keep, then what it would earn reopened. -->
                                <div class="kv" data-if="panel.figures.shown">
                                    <span class="k"><span data-if="panel.figures.mothballed">{{ui_mine_mothballed}}</span><span data-if="!panel.figures.mothballed && panel.figures.loss">{{ui_mine_loses}}</span><span data-if="!panel.figures.mothballed && !panel.figures.loss">{{ui_mine_earns}}</span></span>
                                    <span class="v num"><span class="line" data-class-warn="panel.figures.loss">{{panel.figures.earns}}</span><span class="subline" data-if="!panel.figures.mothballed && panel.figures.note != ''">{{panel.figures.note}}</span><span class="subline" data-if="!panel.figures.mothballed && panel.figures.break_even != ''">{{panel.figures.break_even}}</span></span>
                                </div>
                                <div class="kv" data-if="panel.figures.reopen != ''">
                                    <span class="k">{{ui_mine_if_reopened_key}}</span>
                                    <span class="v num"><span class="line" data-class-warn="panel.figures.reopen_loss">{{panel.figures.reopen}}</span><span class="subline">{{panel.figures.note}}</span><span class="subline">{{panel.figures.break_even}}</span></span>
                                </div>
                                <div class="kv"><span class="k">Region odds</span><span class="v num"><span class="line wrapok">{{panel.odds}}</span></span></div>
                                <h2 style="margin-top: 4dp;"><span class="idx">04</span>{{panel.survey_title}}</h2>
                                <!-- The row's class binding sits one level below the data-for
                                     element: a binding on the repeated element itself is
                                     evaluated once more after the row is removed, and RmlUi
                                     logs an out-of-bounds index when the selection moves to a
                                     plot with fewer estimates. -->
                                <div data-for="e : panel.estimates">
                                    <div class="kv" data-class-locked="e.locked">
                                        <span class="k">{{e.resource}}</span>
                                        <span class="v num"><span class="line">{{e.tonnes}} <span class="err">{{e.error}}</span></span><span class="subline" data-if="e.locked">{{e.needs}}</span><span class="subline major" data-if="e.major">major deposit</span></span>
                                    </div>
                                </div>
                                <div class="kv" data-if="panel.value != ''"><span class="k wide">Value at today's prices</span><span class="v num">{{panel.value}}</span></div>
                                <div class="notice" data-if="panel.notice != ''" data-class-danger="panel.notice_class == 'danger'"><span class="ic">!</span><span class="msg">{{panel.notice}}</span></div>
                                <div class="notice" data-if="panel.contest != ''"><span class="ic">!</span><span class="msg">{{panel.contest}}</span></div>
                                <div class="notice" data-if="panel.survey_note != ''"><span class="ic">!</span><span class="msg">{{panel.survey_note}}</span></div>
                                <!-- Why the Survey button below is disabled: the money
                                     available does not cover the fee. Not shown while a
                                     survey order waits here; its own fee is counted already. -->
                                <div class="notice" data-if="!panel.survey_order.pending && panel.can_survey && !panel.can_afford_survey"><span class="ic">!</span><span class="msg">{{panel.survey_blocked}}</span></div>
                                <div class="actions">
                                    <!-- An order waiting for the clock stands in for its
                                         control: the chip, and Cancel to take it back (spec 007). -->
                                    <div class="field" data-if="panel.listed && !panel.bid_order.pending"><label>Bid</label><input class="text" type="text" data-value="bid_input"/></div>
                                    <button class="primary" data-if="panel.listed && !panel.bid_order.pending" data-event-click="bid(panel.index)">Place bid</button>
                                    <span class="hrow" data-if="panel.bid_order.pending"><span class="chip accent">{{panel.bid_order.text}}</span><span class="chip warn" data-if="panel.bid_order.not_covered">{{ui_not_covered}}</span><button data-event-click="cancel(panel.bid_order.id)">{{ui_cancel}}</button></span>
                                    <button data-if="!panel.survey_order.pending && panel.can_survey && panel.can_afford_survey" data-event-click="survey(panel.index)">{{panel.survey_label}}</button>
                                    <button class="disabled" data-if="!panel.survey_order.pending && (!panel.can_survey || !panel.can_afford_survey)">{{panel.survey_label}}</button>
                                    <span class="hrow" data-if="panel.survey_order.pending"><span class="chip accent">{{panel.survey_order.text}}</span><span class="chip warn" data-if="panel.survey_order.not_covered">{{ui_not_covered}}</span><button data-event-click="cancel(panel.survey_order.id)">{{ui_cancel}}</button></span>
                                    <button class="primary" data-if="!panel.build_order.pending && panel.can_build && panel.can_afford_mine" data-event-click="build(panel.index)">{{panel.build_label}}</button>
                                    <button class="disabled" data-if="!panel.build_order.pending && panel.can_build && !panel.can_afford_mine">{{panel.build_blocked}}</button>
                                    <span class="hrow" data-if="panel.build_order.pending"><span class="chip accent">{{panel.build_order.text}}</span><span class="chip warn" data-if="panel.build_order.not_covered">{{ui_not_covered}}</span><button data-event-click="cancel(panel.build_order.id)">{{ui_cancel}}</button></span>
                                    <button data-if="!panel.mine_order.pending && panel.can_toggle_mine && panel.mine_operating" data-event-click="toggle_mine(panel.mine_index)">Mothball</button>
                                    <button data-if="!panel.mine_order.pending && panel.can_toggle_mine && !panel.mine_operating" data-event-click="toggle_mine(panel.mine_index)">Reopen</button>
                                    <span class="hrow" data-if="panel.mine_order.pending"><span class="chip accent">{{panel.mine_order.text}}</span><button data-event-click="cancel(panel.mine_order.id)">{{ui_cancel}}</button></span>
                                </div>
                            </div>
                        </div>
                        <div class="sheet">
                            <h2><span class="idx">05</span>Research</h2>
                            <div class="research">
                                <span data-for="t : techs" class="tile" data-class-done="t.chip == 'done'" data-class-now="t.researching">{{t.name}}<span class="num" data-if="t.researching"> · {{t.until}}</span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Market -->
            <div data-if="tab == 2">
                <h1>Market</h1>
                <div class="sheet">
                    <h2><span class="idx">01</span>Prices and standing orders</h2>
                    <table>
                        <tr><th class="w-res">Resource</th><th class="w-chart">90 days</th><th class="n w-price">Price</th><th class="n w-stock">Stock</th><th class="w-sell">Sell now</th><th>Standing order</th></tr>
                        <tr data-for="r : resources" class="row" data-class-sel="r.index == selected_resource" data-event-click="select_resource(r.index)">
                            <td class="name wrap"><span class="nowrap">{{r.name}} <span class="pill warn" data-if="r.locked">locked</span></span><span class="sub num">{{r.market_sub}}</span></td>
                            <td><price-chart class="table" data-attr-resource="r.index" days="90" mode="line"/></td>
                            <td class="n"><span class="num">{{r.price_unit}}</span><span class="sub num" data-class-warn="r.ratio_warn">{{r.base_line}}</span></td>
                            <td class="n"><span class="num">{{r.stock}}</span><span class="sub num">{{r.stock_value}}</span></td>
                            <td class="nw">
                                <span class="muted" data-if="r.locked">{{r.locked_note}}</span>
                                <span class="hrow" data-if="!r.locked && r.has_stock"><input class="text" type="text" data-value="sell_input" style="width: 90dp;"/><button class="sm" data-event-click="sell(r.index)">Sell</button><button class="sm" data-event-click="sell_all(r.index)">Sell all</button></span>
                                <span class="muted" data-if="!r.locked && !r.has_stock">no stock</span>
                            </td>
                            <td><span class="pill accent" data-if="r.policy_on">auto-sell</span><span class="pill" data-if="!r.policy_on">manual</span> <span class="pill accent" data-if="r.policy_order.pending">{{r.policy_order.text}}</span><span class="sub">{{r.policy}}</span><span class="sub">{{r.auto_sold}}</span></td>
                        </tr>
                    </table>
                    <!-- Manual sales waiting for the clock. -->
                    <div class="needs" data-if="market_orders.size > 0">
                        <div data-for="o : market_orders" class="nrow">
                            <span class="t"><span class="chip accent">{{o.text}}</span></span>
                            <span class="act"><button class="sm" data-event-click="cancel(o.id)">{{ui_cancel}}</button></span>
                        </div>
                    </div>
                </div>
                <div class="sheet">
                    <h2><span class="idx">02</span>{{standing_title}}</h2>
                    <p class="text2">{{policy_summary}}</p>
                    <div class="actions">
                        <div class="check" data-class-on="policy_enabled" data-event-click="toggle_policy"><span class="box"></span>Auto-sell</div>
                        <div class="field"><label>Reserve</label><input class="text" type="text" data-value="policy_reserve_input" style="width: 90dp;"/></div>
                        <div class="field"><label>Floor</label><input class="text" type="text" data-value="policy_floor_input" style="width: 90dp;"/></div>
                        <button class="sm primary" data-event-click="apply_policy">Apply</button>
                        <span class="hrow" data-if="policy_order.pending"><span class="chip accent">{{policy_order.text}}</span><button class="sm" data-event-click="cancel(policy_order.id)">{{ui_cancel}}</button></span>
                    </div>
                    <span class="sub">{{ui_policy_hint}}</span>
                </div>
                <div class="split">
                    <div class="main">
                        <div class="sheet">
                            <h2><span class="idx">03</span>{{chart_title}}</h2>
                            <price-chart class="big" data-attr-resource="selected_resource" days="360" mode="line"/>
                            <span class="sub">{{chart_note}}</span>
                        </div>
                    </div>
                    <div class="side">
                        <div class="sheet">
                            <h2><span class="idx">04</span>Storage</h2>
                            <div class="kv"><span class="k">Warehouse</span><span class="v"><span class="line num">{{warehouse_value}}</span><span class="subline num">{{storage_tonnes}}</span></span></div>
                            <div class="kv"><span class="k">Cost</span><span class="v"><span class="line num">{{storage_month_long}}</span><span class="subline">{{storage_rate}}</span></span></div>
                            <span class="sub">{{storage_note}}</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Research -->
            <div data-if="tab == 3">
                <h1>Research</h1>
                <div class="sheet">
                    <h2><span class="idx">01</span>Laboratory</h2>
                    <div class="kv"><span class="k">Lab</span><span class="v"><span class="line">{{lab_line}}</span><span class="subline num">{{lab_sub}}</span></span></div>
                </div>
                <div class="sheet">
                    <h2><span class="idx">02</span>Technologies</h2>
                    <table>
                        <tr><th class="w-tech">Technology</th><th class="w-mine">Status</th><th class="n w-money">Cost</th><th class="n w-bids">Days</th><th>Effect</th><th class="act w-start"></th></tr>
                        <tr data-for="t : techs" class="row" data-class-sel="t.researching">
                            <td class="name wrap"><span class="nowrap">{{t.name}}</span><span class="sub" data-if="t.needs != ''">{{t.needs}}</span></td>
                            <td class="nw"><span class="chip" data-class-good="t.chip_class == 'good'" data-class-accent="t.chip_class == 'accent'" data-class-muted="t.chip_class == 'muted'">{{t.chip}}</span></td>
                            <td class="n">{{t.cost}}</td>
                            <td class="n">{{t.days}}</td>
                            <td>{{t.effects}}</td>
                            <td class="act"><button class="sm primary" data-if="t.can_start && !t.order.pending" data-event-click="research(t.index)">Start</button><span class="chip accent" data-if="t.order.pending">{{t.order.text}}</span><button class="sm" data-if="t.order.pending" data-event-click="cancel(t.order.id)">{{ui_cancel}}</button><span class="muted num" data-if="t.researching">{{t.until}}</span><span class="sub" data-if="t.blocked != ''">{{t.blocked}}</span></td>
                        </tr>
                    </table>
                </div>
            </div>

            <!-- Finance -->
            <div data-if="tab == 4">
                <h1>Finance</h1>
                <div class="sheet">
                    <h2><span class="idx">01</span>Finance</h2>
                    <div class="finrow">
                        <div class="stat"><span class="label">Cash</span><span class="value">{{cash}}</span></div>
                        <div class="stat"><span class="label">Available</span><span class="value">{{available}}</span></div>
                        <div class="stat"><span class="label">Debt</span><span class="value">{{debt}}</span><span class="sub">{{capacity_sub}}</span></div>
                        <div class="stat"><span class="label">Warehouse</span><span class="value">{{warehouse_value}}</span><span class="sub wrapok">{{storage_sub}}</span></div>
                        <div class="stat"><span class="label">This month</span><span class="value" data-class-good="month_good" data-class-danger="!month_good">{{month_net}}</span><span class="sub">{{instalment_sub}}</span></div>
                        <div class="stat"><span class="label">Solvency</span><span class="chipline"><span class="chip" data-class-good="solvent" data-class-danger="!solvent">{{solvency}}</span></span><span class="sub wrapok">{{solvency_sub}}</span></div>
                    </div>
                </div>
                <div class="split">
                    <div class="main">
                        <div class="sheet">
                            <h2><span class="idx">02</span>Loans</h2>
                            <table>
                                <tr><th class="w-plot">Loan</th><th class="n">Principal</th><th class="n">Remaining</th><th class="n w-inst">Instalment</th><th class="n w-months">Months</th><th class="act w-repay"></th></tr>
                                <tr data-for="l : loans" class="row">
                                    <td class="name num">{{l.name}}</td>
                                    <td class="n">{{l.principal}}</td>
                                    <td class="n">{{l.remaining}}</td>
                                    <td class="n">{{l.instalment}}</td>
                                    <td class="n">{{l.months}}</td>
                                    <td class="act"><input class="text" type="text" data-value="repay_input"/><button class="sm" data-event-click="repay(l.index)">Repay</button><button class="sm" data-if="l.can_repay_all" data-event-click="repay_all(l.index)">Repay all</button><button class="sm disabled" data-if="!l.can_repay_all">Repay all</button></td>
                                </tr>
                            </table>
                            <span class="sub" data-if="loans.size == 0">No loans outstanding.</span>
                            <!-- Loans and repayments waiting for the clock. -->
                            <div class="needs" data-if="finance_orders.size > 0">
                                <div data-for="o : finance_orders" class="nrow">
                                    <span class="t"><span class="chip accent">{{o.text}}</span></span>
                                    <span class="act"><span class="chip warn" data-if="o.not_covered">{{ui_not_covered}}</span><button class="sm" data-event-click="cancel(o.id)">{{ui_cancel}}</button></span>
                                </div>
                            </div>
                            <span class="sub">{{loan_rule}}</span>
                        </div>
                        <div class="sheet">
                            <h2><span class="idx">03</span>Take a loan</h2>
                            <div class="actions">
                                <div class="field"><label>Amount</label><input class="text" type="text" data-value="loan_input"/></div>
                                <button class="primary" data-if="can_take_loan" data-event-click="take_loan">Take loan</button>
                                <button class="disabled" data-if="!can_take_loan">Take loan</button>
                            </div>
                            <span class="sub">{{loan_credit}}</span>
                            <span class="sub warn" data-if="loan_blocked != ''">{{loan_blocked}}</span>
                            <span class="sub">{{loan_limits}}</span>
                        </div>
                    </div>
                    <div class="side">
                        <div class="sheet">
                            <h2><span class="idx">04</span>Cover costs</h2>
                            <div class="check" data-class-on="cover_costs" data-event-click="toggle_cover_costs"><span class="box"></span>{{cover_check}}</div>
                            <div class="hrow" data-if="cover_order.pending"><span class="chip accent">{{cover_order.text}}</span><button class="sm" data-event-click="cancel(cover_order.id)">{{ui_cancel}}</button></div>
                            <span class="sub">{{cover_explain}}</span>
                            <div class="kv" style="margin-top: 8dp;"><span class="k">Last month</span><span class="v"><span class="line wrapok">{{cover_last}}</span></span></div>
                        </div>
                        <div class="sheet">
                            <h2><span class="idx">05</span>Solvency</h2>
                            <div class="kv"><span class="k">Status</span><span class="v"><span class="line"><span class="chip" data-class-good="solvent" data-class-danger="!solvent">{{solvency}}</span></span><span class="subline">{{solvency_rule}}</span></span></div>
                            <div class="kv"><span class="k">Storage</span><span class="v"><span class="line num">{{storage_month_long}}</span><span class="subline">{{storage_rate}}</span></span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Log -->
            <div data-if="tab == 5">
                <h1>Log</h1>
                <div class="sheet">
                    <h2><span class="idx">01</span>Log</h2>
                    <div class="actions">
                        <button class="sm" data-class-active="log_filter == 0" data-event-click="set_log_filter(0)">All</button>
                        <button class="sm" data-class-active="log_filter == 1" data-event-click="set_log_filter(1)">Mine</button>
                        <button class="sm" data-class-active="log_filter == 2" data-event-click="set_log_filter(2)">Market</button>
                        <button class="sm" data-class-active="log_filter == 3" data-event-click="set_log_filter(3)">Rivals</button>
                    </div>
                    <span class="sub" data-if="log_empty != ''">{{log_empty}}</span>
                    <div class="log">
                        <!-- Class binding one level below the repeated element, as for the
                             survey estimates: the filters shrink this list. -->
                        <div data-for="e : log"><div class="line" data-class-warn="e.warning"><span class="d">{{e.day}}</span><span class="t">{{e.text}}</span></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="status" data-class-danger="status_danger">
        <span class="lbl">Status</span>
        <span data-if="status_line != ''">{{status_line}}</span>
        <span class="muted" data-if="status_line == ''">{{ui_shortcuts}}</span>
    </div>

    <!-- The end screen (spec 010, BR-009). It covers play, header and all, so
         no order control can be reached; New game is the only way on. Which
         ending it was is said in the title and the body, not by a colour. -->
    <div id="overlay" data-if="end.shown">
        <div class="panel">
            <h1>{{end.title}}</h1>
            <p class="body">{{end.body}}</p>
            <p class="day">{{end.day}}</p>
            <div class="cols">
                <div data-for="c : end.companies" class="col">
                    <span class="who">{{c.name}}</span>
                    <span class="count">{{c.stages}}</span>
                    <!-- Class binding one level below the repeated element. -->
                    <div data-for="l : c.lines"><span class="sline" data-class-never="!l.reached">{{l.text}}</span></div>
                </div>
                <div class="col figures">
                    <span class="who">{{end.figures_title}}</span>
                    <div class="kv"><span class="k">{{end.cash_label}}</span><span class="v num">{{end.cash}}</span></div>
                    <div class="kv"><span class="k">{{end.mines_label}}</span><span class="v num">{{end.mines}}</span></div>
                    <div class="kv"><span class="k">{{end.stages_label}}</span><span class="v num">{{end.stages}}</span></div>
                </div>
            </div>
            <div class="foot"><button class="primary" data-event-click="new_game">{{end.new_game}}</button></div>
        </div>
    </div>
</body>
</rml>
